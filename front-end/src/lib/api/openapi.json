{
  "openapi": "3.1.0",
  "info": {
    "title": "Crawler API",
    "summary": "Start, monitor and cancel single-host site crawls.",
    "version": "0.1.0"
  },
  "paths": {
    "/crawls": {
      "get": {
        "tags": [
          "crawls"
        ],
        "summary": "List Crawls",
        "description": "Every crawl held by the service, most recently started first.",
        "operationId": "list_crawls_crawls_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CrawlSummary"
                  },
                  "type": "array",
                  "title": "Response List Crawls Crawls Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "crawls"
        ],
        "summary": "Start Crawl",
        "description": "Start a crawl in the background. Poll its ``/status`` to follow it.",
        "operationId": "start_crawl_crawls_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrawlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrawlSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/crawls/{job_id}": {
      "get": {
        "tags": [
          "crawls"
        ],
        "summary": "Get Crawl",
        "operationId": "get_crawl_crawls__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrawlDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "crawls"
        ],
        "summary": "Cancel Crawl",
        "description": "Cancel a running crawl. The pages it already found are kept.",
        "operationId": "cancel_crawl_crawls__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrawlDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/crawls/{job_id}/status": {
      "get": {
        "tags": [
          "crawls"
        ],
        "summary": "Get Crawl Status",
        "operationId": "get_crawl_status_crawls__job_id__status_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrawlStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/crawls/{job_id}/pages": {
      "get": {
        "tags": [
          "crawls"
        ],
        "summary": "Get Crawl Pages",
        "description": "Pages in the order the crawl reported them, each with its links.",
        "operationId": "get_crawl_pages_crawls__job_id__pages_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/crawls/{job_id}/links": {
      "get": {
        "tags": [
          "crawls"
        ],
        "summary": "Get Crawl Links",
        "description": "Distinct links found on any page, in first-seen order, followed or not.",
        "operationId": "get_crawl_links_crawls__job_id__links_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CrawlDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url",
          "status",
          "started_at",
          "finished_at",
          "stats",
          "limits",
          "error"
        ],
        "title": "CrawlDetail"
      },
      "CrawlRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Absolute http(s) base URL; its host is the crawl scope."
          },
          "max_pages": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pages",
            "description": "Page budget. Defaults to the service's default budget."
          },
          "max_depth": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Depth",
            "description": "Link hops from the base URL."
          },
          "concurrency": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Concurrency",
            "description": "Parallel requests."
          },
          "per_host_concurrency": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Per Host Concurrency",
            "description": "Most parallel requests to any one host. Default: no limit."
          },
          "respect_robots": {
            "type": "boolean",
            "title": "Respect Robots",
            "default": true
          },
          "allowed_hosts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Allowed Hosts",
            "description": "Extra hosts to follow besides the base URL's: 'docs.example.org', 'localhost:8001', or '*.example.com' for any subdomain."
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CrawlRequest"
      },
      "CrawlStatus": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "started_at",
          "finished_at",
          "stats",
          "error"
        ],
        "title": "CrawlStatus",
        "description": "What a client polls: small and cheap."
      },
      "CrawlSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url",
          "status",
          "started_at",
          "finished_at",
          "stats"
        ],
        "title": "CrawlSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "JobStatus"
      },
      "Limits": {
        "properties": {
          "max_pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pages"
          },
          "max_depth": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Depth"
          },
          "concurrency": {
            "type": "integer",
            "title": "Concurrency"
          },
          "per_host_concurrency": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Per Host Concurrency"
          },
          "respect_robots": {
            "type": "boolean",
            "title": "Respect Robots"
          },
          "allowed_hosts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Hosts"
          }
        },
        "type": "object",
        "required": [
          "max_pages",
          "max_depth",
          "concurrency",
          "per_host_concurrency",
          "respect_robots",
          "allowed_hosts"
        ],
        "title": "Limits"
      },
      "LinkList": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "offset",
          "limit",
          "items"
        ],
        "title": "LinkList",
        "description": "Distinct links found anywhere in the crawl, in first-seen order."
      },
      "Page": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Links"
          }
        },
        "type": "object",
        "required": [
          "url",
          "links"
        ],
        "title": "Page"
      },
      "PageList": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Page"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "offset",
          "limit",
          "items"
        ],
        "title": "PageList"
      },
      "Stats": {
        "properties": {
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "fetched": {
            "type": "integer",
            "title": "Fetched"
          },
          "errors": {
            "type": "integer",
            "title": "Errors"
          },
          "robots_skipped": {
            "type": "integer",
            "title": "Robots Skipped"
          }
        },
        "type": "object",
        "required": [
          "pages",
          "fetched",
          "errors",
          "robots_skipped"
        ],
        "title": "Stats"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
